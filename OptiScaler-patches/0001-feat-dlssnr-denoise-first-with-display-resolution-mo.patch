+{
+    std::lock_guard ownersLock(nrOwnersMutex);
+    std::lock_guard stateLock(_state->mutex);
+    if (!_motionDownscalePipelineState && _init)
+        CreateComputePipeline(_device, &_motionDownscalePipelineState, dlssnr_motion_downscale_cso,
+                              sizeof(dlssnr_motion_downscale_cso), nullptr);
+    if (!_motionDownscalePipelineState)
+        return false;
+    return DispatchCompute(cmd, constants, _motionDownscalePipelineState, motion, nullptr, nullptr, nullptr, nullptr,
+                           target, nullptr, nullptr);
+}
