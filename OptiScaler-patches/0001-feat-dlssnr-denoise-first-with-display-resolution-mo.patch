diff --git a/OptiScaler/shaders/dlssnr/DlssNr_DisplayMotion.h b/OptiScaler/shaders/dlssnr/DlssNr_DisplayMotion.h
new file mode 100644
index 0000000..df0daf2
--- /dev/null
+++ b/OptiScaler/shaders/dlssnr/DlssNr_DisplayMotion.h
@@ -0,0 +1,86 @@
+#pragma once
+#include "DlssNr_Guides.h"
+
+#include <algorithm>
+#include <cmath>
+
+// Denoise first with display-resolution motion vectors.
+//
+// The 1:1 pass and NR run on the render-resolution colour, so they need render-resolution motion.
+// A game created without MVLowRes hands DLSS vectors on the output grid, measured in output pixels
+// (after MV scale). Those are resampled onto the render grid by taking, for every render pixel, the
+// output texel under its centre -- never a blend, which would invent motion along object edges --
+// and converting the vector to render pixels. The private passes then see ordinary MVLowRes data:
+// same direction, same on-screen distance, scale 1. Jitter offsets are already in render pixels and
+// pass through unchanged; jittered-MV semantics are preserved because the conversion is linear.
+// The game's own upscaler keeps its original motion texture and parameters.
+namespace DlssNr
+{
+struct DenoiseFirstMotionPlan
+{
+    bool valid = false;
+    // True when the game's vectors are already render-sized and are passed straight through.
+    bool passthrough = false;
+    // Display-sized source region the resample reads (origin + active size); output-sized.
+    GuideRegion source {};
+    // Render-sized target of the resample.
+    GuideExtent target {};
+    // Applied in the resample: game value * scale = render-pixel motion.
+    float bakeScaleX = 1, bakeScaleY = 1;
+    // What the private 1:1 upscaler and NR are told. Passthrough keeps the game's scale.
+    float privateScaleX = 1, privateScaleY = 1;
+    const char* reason = "";
+};
+
+inline float SanitizeMotionScale(float value) { return std::isfinite(value) && value != 0 ? value : 1.0f; }
+
+inline DenoiseFirstMotionPlan PlanDenoiseFirstMotion(bool lowResolutionMotion, GuideExtent motionAllocation,
+                                                     unsigned int motionX, unsigned int motionY, GuideExtent render,
+                                                     GuideExtent output, float mvScaleX, float mvScaleY)
+{
+    DenoiseFirstMotionPlan plan {};
+    mvScaleX = SanitizeMotionScale(mvScaleX);
+    mvScaleY = SanitizeMotionScale(mvScaleY);
+    if (!render.width || !render.height || !output.width || !output.height)
+    {
+        plan.reason = "empty render or output extent";
+        return plan;
+    }
+    if (lowResolutionMotion)
+    {
+        plan.valid = plan.passthrough = true;
+        plan.source = GuideSubrect(motionAllocation, render, motionX, motionY);
+        plan.target = render;
+        plan.privateScaleX = mvScaleX;
+        plan.privateScaleY = mvScaleY;
+        return plan;
+    }
+    if (render.width > output.width || render.height > output.height)
+    {
+        plan.reason = "render extent exceeds the output extent";
+        return plan;
+    }
+    // Display vectors cover the whole output; a clipped allocation would stretch the vectors it has.
+    plan.source = GuideSubrect(motionAllocation, output, motionX, motionY);
+    if (plan.source.width != output.width || plan.source.height != output.height)
+    {
+        plan.reason = "display-resolution motion texture is smaller than the output";
+        return plan;
+    }
+    plan.valid = true;
+    plan.target = render;
+    plan.bakeScaleX = mvScaleX * float(render.width) / float(output.width);
+    plan.bakeScaleY = mvScaleY * float(render.height) / float(output.height);
+    plan.privateScaleX = plan.privateScaleY = 1;
+    return plan;
+}
+
+// The output texel the resample reads for one render pixel, along one axis. Mirrored exactly by
+// dlssnr_motion_downscale.hlsl; the unit test drives both through the same numbers.
+inline unsigned int DisplayMotionSourceTexel(unsigned int renderPixel, unsigned int renderExtent,
+                                             unsigned int sourceExtent, unsigned int sourceOrigin)
+{
+    const float centre = (float(renderPixel) + 0.5f) * float(sourceExtent) / float(renderExtent);
+    return std::min((unsigned int) centre, sourceExtent - 1) + sourceOrigin;
+}
+} // namespace DlssNr
