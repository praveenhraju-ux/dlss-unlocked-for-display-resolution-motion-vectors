diff --git a/OptiScaler/shaders/dlssnr/precompile/dlssnr_motion_downscale.hlsl b/OptiScaler/shaders/dlssnr/precompile/dlssnr_motion_downscale.hlsl
new file mode 100644
index 0000000..7806d99
--- /dev/null
+++ b/OptiScaler/shaders/dlssnr/precompile/dlssnr_motion_downscale.hlsl
@@ -0,0 +1,71 @@
+// Denoise first: display-resolution motion vectors -> render-resolution motion for the 1:1 pass and NR.
+//
+// Each render pixel takes the output-grid vector under its centre (no blending: a blend across an
+// object edge invents motion that neither surface has) and converts it to render pixels. The host
+// (DlssNr_DisplayMotion.h) computes the scale as MV scale * render / output per axis, so direction is
+// kept and the on-screen distance is unchanged; the private passes are then told MV scale 1.
+//
+// Bindings and the constant block match dlssnr_residual.hlsl so DispatchCompute's descriptor table
+// is reused unchanged. Fields used:
+//   gWidth / gHeight                         render-resolution target size
+//   gGuideWidth / gGuideHeight               active display-resolution motion size
+//   gResidualMotionBaseX / Y                 origin of that region in the game's motion texture
+//   gMvScaleX / gMvScaleY                    game value -> render pixels
+// Rebuild: dxc -T cs_6_0 -E CSMain -O3 -Qstrip_debug -Qstrip_reflect dlssnr_motion_downscale.hlsl
+cbuffer Params : register(b0)
+{
+    uint  gMode;
+    float gWhitePoint;
+    uint  gWidth;
+    uint  gHeight;
+    float gTransferStrength;
+    float gColourStrength;
+    uint  gDebugView;
+    float gMaxRatio;
+    uint  gPassthrough;
+    float gMvScaleX;
+    float gMvScaleY;
+    uint  gGuideWidth;
+    uint  gGuideHeight;
+    uint  gCompareMode;
+    float gCompareSplit;
+    float gCompareZoom;
+    uint  gCompareSwap;
+    uint  gTransfer;
+    float gDebugScale;
+    uint  gReversibleMode;
+    uint  gApplyModel;
+    uint  gReserved;
+    float gResidualScale;
+    uint  gSkinProtection;
+    uint  gShowSkinMask;
+    float gSkinDetail;
+    float gSkinColour;
+    float gEnvironmentDetail;
+    float gEnvironmentColour;
+    float gResidualBlend;
+    uint  gResidualHistoryValid;
+    uint  gResidualMotionBaseX;
+    uint  gResidualMotionBaseY;
+};
+
+Texture2D<float4>   gMotion : register(t0); // the game's display-resolution motion vectors
+RWTexture2D<float2> gTarget : register(u0); // RG32F render-resolution motion, in render pixels
+
+// Mirrors DlssNr::DisplayMotionSourceTexel.
+uint SourceTexel(uint pixel, uint renderExtent, uint sourceExtent, uint origin)
+{
+    const float centre = (float(pixel) + 0.5) * float(sourceExtent) / float(renderExtent);
+    return min(uint(centre), sourceExtent - 1) + origin;
+}
+
+[numthreads(8, 8, 1)]
+void CSMain(uint3 id : SV_DispatchThreadID)
+{
+    if (id.x >= gWidth || id.y >= gHeight)
+        return;
+    const uint2 source = uint2(SourceTexel(id.x, gWidth, gGuideWidth, gResidualMotionBaseX),
+                               SourceTexel(id.y, gHeight, gGuideHeight, gResidualMotionBaseY));
+    const float2 motion = gMotion.Load(int3(source, 0)).xy * float2(gMvScaleX, gMvScaleY);
+    gTarget[id.xy] = all(isfinite(motion)) ? motion : float2(0.0, 0.0);
+}
