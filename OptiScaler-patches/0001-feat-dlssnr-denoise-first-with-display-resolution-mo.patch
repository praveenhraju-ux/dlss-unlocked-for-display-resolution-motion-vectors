+
+## Denoise first with display-resolution motion vectors (DX12)
+
+Denoise first runs a private 1:1 DLSS/RR pass and NR at render resolution, so both are created with `MVLowRes`. Games whose upscaler is created without `MVLowRes` (output-resolution vectors, e.g. Stellar Blade) used to leave the mode inactive. `DlssNr_Dx12_DenoiseFirst.cpp` now resamples those vectors into a private render-sized RG32F texture each frame (`dlssnr_motion_downscale.hlsl`):
+
+- Each render pixel takes the output texel under its centre (no blending across object edges), read from the motion region's origin and the DLSS output size given at creation (`OutWidth`/`OutHeight`, else the output texture's size). A motion texture that cannot cover that size leaves the mode inactive with a reason instead of stretching.
+- Values are converted to render pixels with `MV scale × render / output` per axis, so direction and on-screen distance are kept. The private passes then use MV scale 1. Jitter offsets are render pixels in both cases and pass through unchanged; jittered vectors stay consistent because the conversion is linear.
+- The game's motion texture is read in its declared state and returned to it. The private copy rests in `NON_PIXEL_SHADER_RESOURCE`, is a UAV only while written, and belongs to the denoise-first generation, so it is freed by the same GPU-lifetime retirement as the 1:1 feature.
+- The game's own upscaler (steps "game upscaler" and "edit onto raw render") keeps its original parameters and motion. Render-resolution games are unchanged: the game's texture and MV scale are passed straight through.
+
+`tests/nr_denoise_first_display_motion_unit.cpp` (headless) and `tests/nr_denoise_first_display_motion_warp.cpp` (runs the shipped DXIL on WARP) cover scale, direction, jitter, offsets, padding, passthrough and the texel pick.
diff --git a/tests/nr_denoise_first_display_motion_unit.cpp b/tests/nr_denoise_first_display_motion_unit.cpp
new file mode 100644
index 0000000..bc7523e
--- /dev/null
+++ b/tests/nr_denoise_first_display_motion_unit.cpp
@@ -0,0 +1,214 @@
+// Headless regression for denoise first with display-resolution motion vectors (no MVLowRes).
+// No D3D12 or NVIDIA runtime; tests/nr_denoise_first_display_motion_warp.cpp runs the shader itself.
+#include "../OptiScaler/shaders/dlssnr/DlssNr_DisplayMotion.h"
+#include <cassert>
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <vector>
+
+using namespace DlssNr;
+
+static bool Near(float a, float b, float tolerance = 1e-4f)
+{
+    return std::fabs(a - b) <= tolerance * std::max(1.0f, std::max(std::fabs(a), std::fabs(b)));
+}
+
+struct Vec
+{
+    float x, y;
+};
+
+// CPU model of dlssnr_motion_downscale.hlsl.
+static std::vector<Vec> Resample(const std::vector<Vec>& display, unsigned stride, const DenoiseFirstMotionPlan& plan)
+{
+    std::vector<Vec> out(plan.target.width * plan.target.height);
+    for (unsigned y = 0; y < plan.target.height; ++y)
+        for (unsigned x = 0; x < plan.target.width; ++x)
+        {
+            const auto sx = DisplayMotionSourceTexel(x, plan.target.width, plan.source.width, plan.source.x);
+            const auto sy = DisplayMotionSourceTexel(y, plan.target.height, plan.source.height, plan.source.y);
+            const auto v = display[sy * stride + sx];
+            Vec m { v.x * plan.bakeScaleX, v.y * plan.bakeScaleY };
+            if (!std::isfinite(m.x) || !std::isfinite(m.y))
+                m = { 0, 0 };
+            out[y * plan.target.width + x] = m;
+        }
+    return out;
+}
+
+int main()
+{
+    // Stellar Blade, DLSS Balanced (58%) at 4K: 2227x1253 -> 3840x2160, display-resolution vectors.
+    const GuideExtent render { 2227, 1253 }, output { 3840, 2160 };
+    for (const auto scale : { Vec { 1, 1 }, Vec { -1, -1 }, Vec { 3840, 2160 }, Vec { -3840, 2160 } })
+    {
+        const auto plan = PlanDenoiseFirstMotion(false, { 3840, 2160 }, 0, 0, render, output, scale.x, scale.y);
+        assert(plan.valid && !plan.passthrough);
+        assert(plan.target.width == render.width && plan.target.height == render.height);
+        assert(plan.source.x == 0 && plan.source.y == 0);
+        assert(plan.source.width == output.width && plan.source.height == output.height);
+        // The private passes see plain render pixels.
+        assert(plan.privateScaleX == 1 && plan.privateScaleY == 1);
+        // Magnitude: the same fraction of the screen, measured on the other grid.
+        const float raw[2] = { 0.01f, -0.0042f };
+        const float displayPixelsX = raw[0] * scale.x, displayPixelsY = raw[1] * scale.y;
+        const float renderPixelsX = raw[0] * plan.bakeScaleX, renderPixelsY = raw[1] * plan.bakeScaleY;
+        assert(Near(renderPixelsX / render.width, displayPixelsX / output.width));
+        assert(Near(renderPixelsY / render.height, displayPixelsY / output.height));
+        // Direction: signs are kept on each axis; the MV scale sign (engine convention) is not lost.
+        assert((renderPixelsX > 0) == (displayPixelsX > 0) && (renderPixelsY > 0) == (displayPixelsY > 0));
+        assert(Near(std::atan2(renderPixelsY / render.height, renderPixelsX / render.width),
+                    std::atan2(displayPixelsY / output.height, displayPixelsX / output.width)));
+    }
+
+    // Jittered vectors: a pure jitter delta of (jx, jy) render pixels arrives on the display grid as
+    // (jx, jy) * output / render and must come back as exactly (jx, jy) render pixels, so the 1:1
+    // feature's MVJittered handling and the unchanged jitter offsets still agree.
+    {
+        const auto plan = PlanDenoiseFirstMotion(false, { 3840, 2160 }, 0, 0, render, output, 1, 1);
+        const float jx = 0.3125f, jy = -0.4444f;
+        const float dx = jx * output.width / render.width, dy = jy * output.height / render.height;
+        assert(Near(dx * plan.bakeScaleX, jx) && Near(dy * plan.bakeScaleY, jy));
+    }
+
+    // Render-resolution vectors keep the existing path exactly: the game's texture and scale.
+    {
+        const auto plan = PlanDenoiseFirstMotion(true, { 2227, 1253 }, 0, 0, render, output, -2227, 1253);
+        assert(plan.valid && plan.passthrough);
+        assert(plan.privateScaleX == -2227 && plan.privateScaleY == 1253);
+        assert(plan.bakeScaleX == 1 && plan.bakeScaleY == 1);
+    }
+    // Same sanitization as before: zero or non-finite MV scale reads as 1.
+    {
+        const float nan = std::numeric_limits<float>::quiet_NaN();
+        auto plan = PlanDenoiseFirstMotion(true, { 2227, 1253 }, 0, 0, render, output, 0, nan);
+        assert(plan.privateScaleX == 1 && plan.privateScaleY == 1);
+        plan = PlanDenoiseFirstMotion(false, { 3840, 2160 }, 0, 0, render, output, nan, 0);
+        assert(plan.valid && Near(plan.bakeScaleX, 2227.0f / 3840) && Near(plan.bakeScaleY, 1253.0f / 2160));
+    }
+
+    // Padded display allocation (and a non-zero origin): only the output-sized region is read.
+    {
+        const auto plan = PlanDenoiseFirstMotion(false, { 4096, 2304 }, 16, 8, render, output, 1, 1);
+        assert(plan.valid && plan.source.x == 16 && plan.source.y == 8);
+        assert(plan.source.width == 3840 && plan.source.height == 2160);
+        for (unsigned x : { 0u, 1u, render.width / 2, render.width - 1 })
+        {
+            const auto t = DisplayMotionSourceTexel(x, render.width, plan.source.width, plan.source.x);
+            assert(t >= 16 && t < 16 + 3840);
+        }
+    }
+    // A display texture that cannot cover the output is rejected, not stretched.
+    assert(!PlanDenoiseFirstMotion(false, { 2227, 1253 }, 0, 0, render, output, 1, 1).valid);
+    assert(!PlanDenoiseFirstMotion(false, { 3840, 2160 }, 1, 0, render, output, 1, 1).valid);
+    // Render larger than output and empty extents are rejected.
+    assert(!PlanDenoiseFirstMotion(false, { 3840, 2160 }, 0, 0, { 3841, 2160 }, output, 1, 1).valid);
+    assert(!PlanDenoiseFirstMotion(false, { 3840, 2160 }, 0, 0, { 0, 0 }, output, 1, 1).valid);
+    // DLAA-sized "display" vectors are a 1:1 copy.
+    {
+        const auto plan = PlanDenoiseFirstMotion(false, { 1920, 1080 }, 0, 0, { 1920, 1080 }, { 1920, 1080 }, 1, 1);
+        assert(plan.valid && plan.bakeScaleX == 1 && plan.bakeScaleY == 1);
+        for (unsigned x = 0; x < 1920; ++x)
+            assert(DisplayMotionSourceTexel(x, 1920, 1920, 0) == x);
+    }
+
+    // Texel selection: in range, monotonic, the texel under the render pixel centre, symmetric at both
+    // edges, for every axis of the common DLSS ratios at 1440p and 4K.
+    for (const auto& [r, o] : { std::pair<unsigned, unsigned> { 2227, 3840 },
+                                { 1253, 2160 },
+                                { 1485, 2560 },
+                                { 835, 1440 },
+                                { 1920, 3840 },
+                                { 1280, 3840 },
+                                { 2560, 3840 },
+                                { 1706, 2560 } })
+    {
+        unsigned previous = 0;
+        for (unsigned x = 0; x < r; ++x)
+        {
+            const auto t = DisplayMotionSourceTexel(x, r, o, 0);
+            assert(t < o && t >= previous);
+            const double centre = (x + 0.5) * double(o) / double(r);
+            assert(t <= centre + 1e-3 && centre < t + 1 + 1e-3);
+            previous = t;
+            const auto mirrored = DisplayMotionSourceTexel(r - 1 - x, r, o, 0);
+            assert(std::abs(int(t + mirrored) - int(o - 1)) <= 1);
+        }
+    }
+
+    // End to end on a synthetic field: a camera pan plus a rotation about the screen centre, given in
+    // display pixels. Every resampled vector equals the analytic motion at that render pixel's centre
+    // to within the half-texel the nearest pick can move, and is in render pixels.
+    {
+        const GuideExtent r { 445, 251 }, o { 768, 432 }; // Balanced proportions, small enough to sweep
+        std::vector<Vec> display(o.width * o.height);
+        const float panX = 12.5f, panY = -3.25f, spin = 0.01f;
+        auto field = [&](float px, float py) // display pixels at display position
+        {
+            const float cx = px - o.width * 0.5f, cy = py - o.height * 0.5f;
+            return Vec { panX - spin * cy, panY + spin * cx };
+        };
+        for (unsigned y = 0; y < o.height; ++y)
+            for (unsigned x = 0; x < o.width; ++x)
+                display[y * o.width + x] = field(x + 0.5f, y + 0.5f);
+        display[0] = { std::numeric_limits<float>::infinity(), 0 }; // a corrupt texel becomes zero
+        const auto plan = PlanDenoiseFirstMotion(false, o, 0, 0, r, o, 1, 1);
+        assert(plan.valid);
+        const auto out = Resample(display, o.width, plan);
+        assert(out[0].x == 0 && out[0].y == 0);
+        const float sx = float(r.width) / o.width, sy = float(r.height) / o.height;
+        for (unsigned y = 0; y < r.height; ++y)
+            for (unsigned x = 0; x < r.width; ++x)
+            {
+                if (!x && !y)
+                    continue;
+                const float px = (x + 0.5f) / sx, py = (y + 0.5f) / sy; // render centre on the display grid
+                const auto expected = field(px, py);
+                const auto got = out[y * r.width + x];
+                const float slack = spin * 1.0f + 1e-3f; // one display texel of rotation
+                assert(std::fabs(got.x / sx - expected.x) <= slack && std::fabs(got.y / sy - expected.y) <= slack);
+            }
+    }
+    // Every DLSS mode at 1080p, 1440p and 4K: DLAA, Quality, Balanced, Performance, Ultra Performance.
+    // Render sizes as NGX reports them (rounded output x ratio). The plan must accept each, the texel
+    // pick must stay in range, and a pan + rotation field (display pixels) must come back as the same
+    // on-screen motion in render pixels to within one display texel of the field's gradient.
+    for (const GuideExtent display : { GuideExtent { 1920, 1080 }, { 2560, 1440 }, { 3840, 2160 } })
+        for (const double ratio : { 1.0, 2.0 / 3.0, 0.58, 0.5, 1.0 / 3.0 })
+        {
+            const GuideExtent r { (unsigned) std::lround(display.width * ratio),
+                                  (unsigned) std::lround(display.height * ratio) };
+            const auto plan = PlanDenoiseFirstMotion(false, display, 0, 0, r, display, 1, 1);
+            assert(plan.valid && !plan.passthrough && plan.target.width == r.width && plan.target.height == r.height);
+            assert(Near(plan.bakeScaleX, float(r.width) / display.width) &&
+                   Near(plan.bakeScaleY, float(r.height) / display.height));
+            if (ratio == 1.0)
+                assert(plan.bakeScaleX == 1 && plan.bakeScaleY == 1); // DLAA: an exact copy
+            // A quarter-size sweep keeps the run short while hitting the same ratios.
+            const GuideExtent o { display.width / 4, display.height / 4 };
+            const GuideExtent rs { std::max(1u, (unsigned) std::lround(o.width * ratio)),
+                                   std::max(1u, (unsigned) std::lround(o.height * ratio)) };
+            const auto small = PlanDenoiseFirstMotion(false, o, 0, 0, rs, o, 1, 1);
+            assert(small.valid);
+            std::vector<Vec> field(o.width * o.height);
+            auto motionAt = [&](float px, float py)
+            { return Vec { 7.0f - 0.02f * (py - o.height * 0.5f), -2.5f + 0.02f * (px - o.width * 0.5f) }; };
+            for (unsigned y = 0; y < o.height; ++y)
+                for (unsigned x = 0; x < o.width; ++x)
+                    field[y * o.width + x] = motionAt(x + 0.5f, y + 0.5f);
+            const auto out = Resample(field, o.width, small);
+            const float sx = float(rs.width) / o.width, sy = float(rs.height) / o.height;
+            for (unsigned y = 0; y < rs.height; ++y)
+                for (unsigned x = 0; x < rs.width; ++x)
+                {
+                    const auto expected = motionAt((x + 0.5f) / sx, (y + 0.5f) / sy);
+                    const auto got = out[y * rs.width + x];
+                    assert(std::fabs(got.x / sx - expected.x) <= 0.021f &&
+                           std::fabs(got.y / sy - expected.y) <= 0.021f);
+                }
+        }
+
+    std::puts("PASS: denoise first display-resolution motion (scale, direction, jitter, offsets, passthrough, "
+              "texel selection, synthetic field, DLAA/Quality/Balanced/Performance/Ultra Performance)");
+}
diff --git a/tests/nr_denoise_first_display_motion_warp.cpp b/tests/nr_denoise_first_display_motion_warp.cpp
new file mode 100644
index 0000000..8a6c068
--- /dev/null
+++ b/tests/nr_denoise_first_display_motion_warp.cpp
@@ -0,0 +1,265 @@
+// WARP executes the shipped dlssnr_motion_downscale DXIL. No game or NVIDIA runtime.
+// Run: tests/run_nr_denoise_first_display_motion.ps1
+#define NOMINMAX
+#include <windows.h>
+#include <d3d12.h>
+#include <dxgi1_4.h>
+#include <wrl/client.h>
+#include <cmath>
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+#include "../OptiScaler/shaders/dlssnr/DlssNr_Common.h"
+#include "../OptiScaler/shaders/dlssnr/DlssNr_DisplayMotion.h"
+#include "../OptiScaler/shaders/dlssnr/precompile/dlssnr_motion_downscale_Shader.h"
+
+using Microsoft::WRL::ComPtr;
+static void check(HRESULT hr)
+{
+    if (FAILED(hr))
+        throw std::runtime_error("D3D12 call failed");
+}
+static void expect(bool ok, const char* why)
+{
+    if (!ok)
+        throw std::runtime_error(why);
+}
+struct Vec
+{
+    float x, y;
+};
+
+int main()
+try
+{
+    // The HLSL cbuffer reads these fields at these offsets.
+    static_assert(sizeof(DlssNrConstants) == 256);
+    static_assert(offsetof(DlssNrConstants, Width) == 8 && offsetof(DlssNrConstants, Height) == 12);
+    static_assert(offsetof(DlssNrConstants, MvScaleX) == 36 && offsetof(DlssNrConstants, MvScaleY) == 40);
+    static_assert(offsetof(DlssNrConstants, GuideWidth) == 44 && offsetof(DlssNrConstants, GuideHeight) == 48);
+    static_assert(offsetof(DlssNrConstants, ResidualMotionBaseX) == 124 &&
+                  offsetof(DlssNrConstants, ResidualMotionBaseY) == 128);
+
+    ComPtr<IDXGIFactory4> factory;
+    ComPtr<IDXGIAdapter> adapter;
+    ComPtr<ID3D12Device> device;
+    check(CreateDXGIFactory1(IID_PPV_ARGS(&factory)));
+    check(factory->EnumWarpAdapter(IID_PPV_ARGS(&adapter)));
+    check(D3D12CreateDevice(adapter.Get(), D3D_FEATURE_LEVEL_11_0, IID_PPV_ARGS(&device)));
+
+    // b0, t0, u0 -- the slots the production descriptor table puts first.
+    D3D12_DESCRIPTOR_RANGE ranges[2] {};
+    ranges[0] = { D3D12_DESCRIPTOR_RANGE_TYPE_SRV, 1, 0, 0, 0 };
+    ranges[1] = { D3D12_DESCRIPTOR_RANGE_TYPE_UAV, 1, 0, 0, 1 };
+    D3D12_ROOT_PARAMETER params[2] {};
+    params[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_CBV;
+    params[0].Descriptor = { 0, 0 };
+    params[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    params[1].DescriptorTable = { 2, ranges };
+    D3D12_ROOT_SIGNATURE_DESC rsDesc { 2, params, 0, nullptr, D3D12_ROOT_SIGNATURE_FLAG_NONE };
+    ComPtr<ID3DBlob> rsBlob, rsErrors;
+    check(D3D12SerializeRootSignature(&rsDesc, D3D_ROOT_SIGNATURE_VERSION_1, &rsBlob, &rsErrors));
+    ComPtr<ID3D12RootSignature> rootSignature;
+    check(device->CreateRootSignature(0, rsBlob->GetBufferPointer(), rsBlob->GetBufferSize(),
+                                      IID_PPV_ARGS(&rootSignature)));
+    D3D12_COMPUTE_PIPELINE_STATE_DESC psoDesc {};
+    psoDesc.pRootSignature = rootSignature.Get();
+    psoDesc.CS = { dlssnr_motion_downscale_cso, sizeof(dlssnr_motion_downscale_cso) };
+    ComPtr<ID3D12PipelineState> pso;
+    check(device->CreateComputePipelineState(&psoDesc, IID_PPV_ARGS(&pso)));
+
+    D3D12_COMMAND_QUEUE_DESC qd { D3D12_COMMAND_LIST_TYPE_DIRECT };
+    ComPtr<ID3D12CommandQueue> queue;
+    check(device->CreateCommandQueue(&qd, IID_PPV_ARGS(&queue)));
+    ComPtr<ID3D12Fence> fence;
+    check(device->CreateFence(0, D3D12_FENCE_FLAG_NONE, IID_PPV_ARGS(&fence)));
+    UINT64 fenceValue = 0;
+
+    auto buffer = [&](D3D12_HEAP_TYPE type, UINT64 size, D3D12_RESOURCE_STATES state)
+    {
+        D3D12_HEAP_PROPERTIES heap { type };
+        D3D12_RESOURCE_DESC d {};
+        d.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER;
+        d.Width = size;
+        d.Height = d.DepthOrArraySize = d.MipLevels = d.SampleDesc.Count = 1;
+        d.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+        ComPtr<ID3D12Resource> r;
+        check(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &d, state, nullptr, IID_PPV_ARGS(&r)));
+        return r;
+    };
+    auto texture = [&](unsigned w, unsigned h, D3D12_RESOURCE_FLAGS flags, D3D12_RESOURCE_STATES state)
+    {
+        D3D12_HEAP_PROPERTIES heap { D3D12_HEAP_TYPE_DEFAULT };
+        D3D12_RESOURCE_DESC d {};
+        d.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        d.Width = w;
+        d.Height = h;
+        d.DepthOrArraySize = d.MipLevels = d.SampleDesc.Count = 1;
+        d.Format = DXGI_FORMAT_R32G32_FLOAT;
+        d.Flags = flags;
+        ComPtr<ID3D12Resource> r;
+        check(device->CreateCommittedResource(&heap, D3D12_HEAP_FLAG_NONE, &d, state, nullptr, IID_PPV_ARGS(&r)));
+        return r;
+    };
+
+    // Runs the shader the way DenoiseFirstContext::Before does and returns the render-sized result.
+    auto run = [&](const std::vector<Vec>& display, unsigned allocW, unsigned allocH,
+                   const DlssNr::DenoiseFirstMotionPlan& plan)
+    {
+        const unsigned w = plan.target.width, h = plan.target.height;
+        auto source = texture(allocW, allocH, D3D12_RESOURCE_FLAG_NONE, D3D12_RESOURCE_STATE_COPY_DEST);
+        auto target =
+            texture(w, h, D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        D3D12_PLACED_SUBRESOURCE_FOOTPRINT up {}, down {};
+        UINT64 upSize = 0, downSize = 0;
+        auto sd = source->GetDesc(), td = target->GetDesc();
+        device->GetCopyableFootprints(&sd, 0, 1, 0, &up, nullptr, nullptr, &upSize);
+        device->GetCopyableFootprints(&td, 0, 1, 0, &down, nullptr, nullptr, &downSize);
+        auto upload = buffer(D3D12_HEAP_TYPE_UPLOAD, upSize, D3D12_RESOURCE_STATE_GENERIC_READ);
+        auto readback = buffer(D3D12_HEAP_TYPE_READBACK, downSize, D3D12_RESOURCE_STATE_COPY_DEST);
+        auto constants = buffer(D3D12_HEAP_TYPE_UPLOAD, 256, D3D12_RESOURCE_STATE_GENERIC_READ);
+        unsigned char* mapped = nullptr;
+        check(upload->Map(0, nullptr, (void**) &mapped));
+        for (unsigned y = 0; y < allocH; ++y)
+            std::memcpy(mapped + up.Offset + y * up.Footprint.RowPitch, &display[y * allocW], allocW * sizeof(Vec));
+        upload->Unmap(0, nullptr);
+        DlssNrConstants c {};
+        c.Width = w;
+        c.Height = h;
+        c.GuideWidth = plan.source.width;
+        c.GuideHeight = plan.source.height;
+        c.ResidualMotionBaseX = plan.source.x;
+        c.ResidualMotionBaseY = plan.source.y;
+        c.MvScaleX = plan.bakeScaleX;
+        c.MvScaleY = plan.bakeScaleY;
+        check(constants->Map(0, nullptr, (void**) &mapped));
+        std::memcpy(mapped, &c, sizeof(c));
+        constants->Unmap(0, nullptr);
+
+        D3D12_DESCRIPTOR_HEAP_DESC hd { D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV, 2,
+                                        D3D12_DESCRIPTOR_HEAP_FLAG_SHADER_VISIBLE };
+        ComPtr<ID3D12DescriptorHeap> heap;
+        check(device->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&heap)));
+        const auto inc = device->GetDescriptorHandleIncrementSize(D3D12_DESCRIPTOR_HEAP_TYPE_CBV_SRV_UAV);
+        auto cpu = heap->GetCPUDescriptorHandleForHeapStart();
+        D3D12_SHADER_RESOURCE_VIEW_DESC srv {};
+        srv.Format = DXGI_FORMAT_R32G32_FLOAT;
+        srv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+        srv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+        srv.Texture2D.MipLevels = 1;
+        device->CreateShaderResourceView(source.Get(), &srv, cpu);
+        cpu.ptr += inc;
+        D3D12_UNORDERED_ACCESS_VIEW_DESC uav {};
+        uav.Format = DXGI_FORMAT_R32G32_FLOAT;
+        uav.ViewDimension = D3D12_UAV_DIMENSION_TEXTURE2D;
+        device->CreateUnorderedAccessView(target.Get(), nullptr, &uav, cpu);
+
+        ComPtr<ID3D12CommandAllocator> allocator;
+        ComPtr<ID3D12GraphicsCommandList> cmd;
+        check(device->CreateCommandAllocator(D3D12_COMMAND_LIST_TYPE_DIRECT, IID_PPV_ARGS(&allocator)));
+        check(
+            device->CreateCommandList(0, D3D12_COMMAND_LIST_TYPE_DIRECT, allocator.Get(), nullptr, IID_PPV_ARGS(&cmd)));
+        D3D12_TEXTURE_COPY_LOCATION dst { source.Get(), D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX };
+        D3D12_TEXTURE_COPY_LOCATION src { upload.Get(), D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT };
+        src.PlacedFootprint = up;
+        cmd->CopyTextureRegion(&dst, 0, 0, 0, &src, nullptr);
+        auto barrier = [&](ID3D12Resource* r, D3D12_RESOURCE_STATES from, D3D12_RESOURCE_STATES to)
+        {
+            D3D12_RESOURCE_BARRIER b {};
+            b.Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
+            b.Transition = { r, D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES, from, to };
+            cmd->ResourceBarrier(1, &b);
+        };
+        // The production state sequence: game motion read as NON_PIXEL_SHADER_RESOURCE, the private
+        // copy rests readable and is a UAV only while it is written.
+        barrier(source.Get(), D3D12_RESOURCE_STATE_COPY_DEST, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        barrier(target.Get(), D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+        ID3D12DescriptorHeap* heaps[] = { heap.Get() };
+        cmd->SetDescriptorHeaps(1, heaps);
+        cmd->SetComputeRootSignature(rootSignature.Get());
+        cmd->SetPipelineState(pso.Get());
+        cmd->SetComputeRootConstantBufferView(0, constants->GetGPUVirtualAddress());
+        cmd->SetComputeRootDescriptorTable(1, heap->GetGPUDescriptorHandleForHeapStart());
+        cmd->Dispatch((w + 7) / 8, (h + 7) / 8, 1);
+        barrier(target.Get(), D3D12_RESOURCE_STATE_UNORDERED_ACCESS, D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE);
+        barrier(target.Get(), D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE, D3D12_RESOURCE_STATE_COPY_SOURCE);
+        D3D12_TEXTURE_COPY_LOCATION rbDst { readback.Get(), D3D12_TEXTURE_COPY_TYPE_PLACED_FOOTPRINT };
+        rbDst.PlacedFootprint = down;
+        D3D12_TEXTURE_COPY_LOCATION rbSrc { target.Get(), D3D12_TEXTURE_COPY_TYPE_SUBRESOURCE_INDEX };
+        cmd->CopyTextureRegion(&rbDst, 0, 0, 0, &rbSrc, nullptr);
+        check(cmd->Close());
+        ID3D12CommandList* lists[] = { cmd.Get() };
+        queue->ExecuteCommandLists(1, lists);
+        check(queue->Signal(fence.Get(), ++fenceValue));
+        HANDLE event = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        check(fence->SetEventOnCompletion(fenceValue, event));
+        WaitForSingleObject(event, INFINITE);
+        CloseHandle(event);
+        check(device->GetDeviceRemovedReason());
+        std::vector<Vec> out(w * h);
+        check(readback->Map(0, nullptr, (void**) &mapped));
+        for (unsigned y = 0; y < h; ++y)
+            std::memcpy(&out[y * w], mapped + down.Offset + y * down.Footprint.RowPitch, w * sizeof(Vec));
+        readback->Unmap(0, nullptr);
+        return out;
+    };
+
+    // Every DLSS mode (DLAA, Quality, Balanced, Performance, Ultra Performance) at reduced size,
+    // padded allocation with an origin, a pan + rotation field in display pixels, and an
+    // engine-style negative Y scale.
+    const unsigned outW = 768, outH = 432, padW = 800, padH = 448, baseX = 16, baseY = 8;
+    for (const double ratio : { 1.0, 2.0 / 3.0, 0.58, 0.5, 1.0 / 3.0 })
+    {
+        const DlssNr::GuideExtent render { (unsigned) std::lround(outW * ratio), (unsigned) std::lround(outH * ratio) };
+        std::vector<Vec> display(padW * padH, Vec { 1e6f, 1e6f }); // padding must never be read
+        const float scaleX = 2.0f, scaleY = -0.5f;                 // raw value * scale = display pixels
+        auto field = [&](float px, float py)
+        {
+            const float cx = px - outW * 0.5f, cy = py - outH * 0.5f;
+            return Vec { 12.5f - 0.01f * cy, -3.25f + 0.01f * cx };
+        };
+        for (unsigned y = 0; y < outH; ++y)
+            for (unsigned x = 0; x < outW; ++x)
+            {
+                const auto m = field(x + 0.5f, y + 0.5f);
+                display[(y + baseY) * padW + x + baseX] = { m.x / scaleX, m.y / scaleY };
+            }
+        display[baseY * padW + baseX] = { std::numeric_limits<float>::quiet_NaN(), 1 };
+        const auto plan =
+            DlssNr::PlanDenoiseFirstMotion(false, { padW, padH }, baseX, baseY, render, { outW, outH }, scaleX, scaleY);
+        expect(plan.valid && !plan.passthrough, "plan rejected a valid display-resolution frame");
+        const auto out = run(display, padW, padH, plan);
+        expect(out[0].x == 0 && out[0].y == 0, "non-finite motion was not cleared");
+        const float sx = float(render.width) / outW, sy = float(render.height) / outH;
+        for (unsigned y = 0; y < render.height; ++y)
+            for (unsigned x = 0; x < render.width; ++x)
+            {
+                if (!x && !y)
+                    continue;
+                const auto got = out[y * render.width + x];
+                expect(std::fabs(got.x) < 1000 && std::fabs(got.y) < 1000, "padding outside the region was read");
+                // Bit-for-bit agreement with the CPU model of the texel pick and scale.
+                const auto tx = DlssNr::DisplayMotionSourceTexel(x, render.width, outW, baseX);
+                const auto ty = DlssNr::DisplayMotionSourceTexel(y, render.height, outH, baseY);
+                const auto raw = display[ty * padW + tx];
+                expect(std::fabs(got.x - raw.x * plan.bakeScaleX) <= 1e-4f * std::max(1.0f, std::fabs(got.x)) &&
+                           std::fabs(got.y - raw.y * plan.bakeScaleY) <= 1e-4f * std::max(1.0f, std::fabs(got.y)),
+                       "shader texel pick or scale differs from DlssNr_DisplayMotion.h");
+                // And the physical meaning: render pixels for the motion at that render pixel's centre.
+                const auto expected = field((x + 0.5f) / sx, (y + 0.5f) / sy);
+                expect(std::fabs(got.x / sx - expected.x) <= 0.011f && std::fabs(got.y / sy - expected.y) <= 0.011f,
+                       "render-resolution motion does not match the display-resolution motion");
+            }
+    }
+    std::puts("PASS: WARP display-resolution motion downscale (DXIL, offsets, padding, scale, NaN guard, "
+              "DLAA/Quality/Balanced/Performance/Ultra Performance)");
+    return 0;
+}
+catch (const std::exception& e)
+{
+    std::fprintf(stderr, "FAIL: %s\n", e.what());
+    return 1;
+}
